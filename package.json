{
  "name": "taskforge360-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "security": "node scripts/security-check.mts",
    "security:semgrep": "semgrep scan --config p/owasp-top-ten --config p/default --config p/secrets --config p/typescript --config p/react --severity ERROR --severity WARNING --metrics=off --disable-version-check .",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "axios": "^1.21.1",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.7",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
    "@vitest/ui": "^5.1.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@auth/core": "$@auth/core",
    "cookie": ">=0.7.0",
    "uuid": ">=11.1.1",
    "postcss": ">=8.5.10"
  }
}
